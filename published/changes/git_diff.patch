+    if family == "composite" and isinstance(out.get("parts"), list):
+        raw_parts = [canonicalize_descriptor(p) for p in out["parts"]]
+        combine = out.get("combine", "concat")
+        if combine == "weighted_p":
+            combine = "mix"
